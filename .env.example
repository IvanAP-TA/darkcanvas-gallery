# EmailJS configuration
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Site URLs (for sitemap generation)
VITE_SITE_URL=https://annibalepace.com

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase configuration (required for CMS backend)
# Get these from your Supabase project settings → API → Project URL + Project API keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...  # anon/public key from Supabase
# Fallback: VITE_SUPABASE_ANON_KEY also works if PUBLISHABLE_KEY is not set